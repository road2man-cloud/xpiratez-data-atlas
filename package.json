{
  "name": "xpiratez-data-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node tools/build-data.mjs",
    "build:facilities": "node tools/build-data.mjs --facility-only",
    "check": "node tools/check-data.mjs",
    "check:facilities": "node tools/check-facilities.mjs",
    "build:item-research": "node tools/build-item-research-data.mjs",
    "build:manufacture": "node tools/build-manufacture-data.mjs",
    "build:events": "node tools/build-event-data.mjs",
    "build:enemy-forces": "node tools/build-enemy-force-data.mjs",
    "build:research-editorial": "node tools/build-research-editorial-insights.mjs",
    "build:item-usage": "node tools/build-item-usage-insights.mjs",
    "build:item-editorial": "npm run build:item-usage && node tools/build-item-editorial-insights.mjs",
    "build:editorials": "npm run build:research-editorial && npm run build:item-editorial",
    "check:item-research": "node tools/check-item-research-data.mjs",
    "check:item-usage": "node tools/check-item-usage-insights.mjs",
    "check:manufacture": "node tools/check-manufacture.mjs --data public/data",
    "check:events": "node tools/check-events.mjs --data public/data",
    "check:enemy-forces": "node tools/check-enemy-forces.mjs --data public/data",
    "check:craft-weapons": "node tools/check-craft-weapons.mjs --data public/data",
    "check:editorials": "node tools/check-editorial-quality.mjs --data public/items/data",
    "check:choices": "node tools/check-choice-coverage.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
