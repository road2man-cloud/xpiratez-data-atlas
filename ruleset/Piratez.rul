    battleType: 4
  - type: STR_MAZETRAP_3
    refNode: *MAZETRAP
    battleType: 4
    scripts:
      createItem: |
        var int fuseLength;
        var int difficulty;
        battle_game.difficultyLevel difficulty;
          if eq difficulty 0;
            set fuseLength -1;
          end;
          if eq difficulty 1;
            battle_game.randomRange fuseLength 40 99;
          end;
          if eq difficulty 2;
            battle_game.randomRange fuseLength 30 89;
          end;
          if eq difficulty 3;
            battle_game.randomRange fuseLength 17 79;
          end;
          if eq difficulty 4;
            battle_game.randomRange fuseLength 2 49;
          end;
          item.setFuseTimer fuseLength;
        return;
