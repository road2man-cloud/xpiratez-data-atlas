    scripts:
      selectUnitSprite: |
        var int temp;

        if  or eq blit_part blit_large_propulsion_0 eq blit_part blit_large_propulsion_1 eq blit_part blit_large_propulsion_2 eq blit_part blit_large_propulsion_3;

          unit.getId temp;
          offsetmod temp 11 0 8; #desync animation of different units
          add temp anim_frame;
          set sprite_index blit_part;
          sub sprite_index 16;
          mul sprite_index 8;
          add sprite_index 32;
          set sprite_offset temp;
          mod sprite_offset 8;

        end;

        add sprite_index sprite_offset;
        return sprite_index;
