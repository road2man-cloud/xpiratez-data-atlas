      - 3.0
      - 0.0
      - 1.0
      - 1.0
      - 0.1
      - 0.25
      - 1.0
      - 1.0
      - 0.0
      - 1.0
    builtInWeapons:
      - STR_PARROT_BEAK
      - INV_NULL_HAND_L
      - INV_NULL_4X3
      - INV_NULL_4X2
      - INV_NULL_1X1_LL
      - INV_NULL_1X1_RL
      - INV_NULL_2X1_RS
      - INV_NULL_2X1_LS
      - INV_NULL_1X2_QD
      - INV_NULL_HAT_NOTORSO
      - INV_NULL_TORSO3
    loftempsSet: [ 1 ]
    scripts:
      selectUnitSprite: |
        var int temp;
        var int collapsing;
        var int walking;
        unit.isCollapsing collapsing;
        unit.isWalking walking;
        if and eq walking 0 eq collapsing 0;
          unit.getId temp;
          offsetmod temp 11 0 8; #desync animation of different units
          add temp anim_frame;
          wavegen_saw temp 8 8 7;
          mul sprite_offset 8;
          add sprite_offset 8;
          add sprite_offset temp;
          set sprite_index sprite_offset;
        else;
          add sprite_index sprite_offset;
        end;
        return sprite_index;
