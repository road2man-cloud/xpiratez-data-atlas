+// Stage 21: read-only opt-in logging of the ACTUAL top interface, not merely the
+// rendered mission background. No changes to interface dispatch or game saves.
+static void XPZ3DTraceInterfaceStack( const char *event, bool periodic = false )
+{
+	char gate[8] = { 0 };
+	if ( GetEnvironmentVariableA( "XPZ3D_INTERFACE_STACK_DIAG", gate, sizeof(gate) ) != 1 || gate[0] != '1' )
+		return;
+	static DWORD lastReport = 0;
+	DWORD now = GetTickCount();
+	if ( periodic && lastReport != 0 && now - lastReport < 2000 ) return;
+	if ( periodic ) lastReport = now;
+	FILE *f = 0;
+	if ( fopen_s( &f, "_xpz_interface_stack.log", "a" ) != 0 || !f ) return;
+	IInterfaceBase *pTop = interfaces.empty() ? 0 : interfaces.back().GetPtr();
+	fprintf( f, "event=%s depth=%u top=%s top_ptr=%p pending_cmds=%u active=%d tick=%lu\n",
+		event, (unsigned)interfaces.size(), pTop ? typeid(*pTop).name() : "none",
+		(void*)pTop, (unsigned)cmds.size(), bAppIsActive ? 1 : 0, (unsigned long)now );
+	unsigned int index = 0;
+	for ( list< CObj<IInterfaceBase> >::const_iterator i = interfaces.begin(); i != interfaces.end(); ++i, ++index )
+	{
+		IInterfaceBase *p = i->GetPtr();
+		fprintf( f, "event=stack_item index=%u type=%s ptr=%p tick=%lu\n",
+			index, p ? typeid(*p).name() : "none", (void*)p, (unsigned long)now );
+	}
+	fclose( f );
+}
