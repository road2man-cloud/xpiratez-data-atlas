+// A different session token for every engine process prevents stale inbox files,
+// logs and ACKs from being accepted after an engine restart.
+static string HarnessSession()
+{
+	char buffer[96] = { 0 };
+	DWORD n = GetEnvironmentVariableA( "XPZ3D_HARNESS_SESSION", buffer, sizeof(buffer) );
+	if ( n >= sizeof(buffer) )
+		return "INVALID_SESSION_ENV";
+	return string( buffer );
+}
