@@ -687,6 +688,66 @@ static void XPZ3DNativeMoveProbe( const string &szID, const vector<wstring> &szP
 		XPZ3DMoveTestLog( "event=refused reason=no_path_network" );
 		return;
 	}
+	// Stage25: observe the actual native floor/path layers under the visual
+	// tower. A declared floor slot or an AI hull is NOT proof of a traversable
+	// deck. This is a read-only probe and cannot create floor links.
+	if ( command == "deckscan" )
+	{
+		char stage25Flag[8] = { 0 };
+		if ( GetEnvironmentVariableA( "XPZ3D_STAGE25_NATIVE_MAP", stage25Flag, sizeof(stage25Flag) ) != 1 ||
+			stage25Flag[0] != '1' )
+		{
+			XPZ3DMoveTestLog( "event=deckscan_refused reason=not_stage25" );
+			return;
+		}
+		const int layerCount = network->GetNumLayers();
+		const int sampleX = 56, sampleY = 56; // 35m,35m inside the 20x20m tower
+		int validLayerCount = 0, reachableFloorMask = 0, standingFloorMask = 0, edgeFloorMask = 0;
+		XPZ3DMoveTestLog( "event=deckscan_begin layers=%d sample=%d,%d slots=12", layerCount, sampleX, sampleY );
+		for ( int layer = 0; layer < layerCount && layer < 128; ++layer )
+		{
+			NAI::SPathPlace point( sampleX, sampleY, layer );
+			const int floor = network->GetFloor( layer );
+			const NAI::EPassable pass = network->GetPassability( point );
+			bool dest = false;
+			int standing = -1, adjacent = -1, edge = -1;
+			float surfaceHeight = -1.0f;
+			if ( pass == NAI::AIP_YES )
+			{
+				dest = network->IsValidDestination( point );
+				NAI::SPosition pp = from;
+				pp.p = point;
+				surfaceHeight = pp.GetCP().z;
+				if ( dest )
+				{
+					++validLayerCount;
+					if ( floor >= 0 && floor < 10 && fabs( surfaceHeight - (float)floor * 2.5f ) < 0.4f )
+					{
+						reachableFloorMask |= ( 1 << floor );
+						NAI::SPathPlace standPoint( point );
+						standPoint.SetPose( NAI::CM_STAND );
+						NAI::SPathPlace nextPoint( sampleX + 1, sampleY, layer );
+						nextPoint.SetPose( NAI::CM_STAND );
+						standing = (int)network->GetPassability( standPoint );
+						adjacent = (int)network->GetPassability( nextPoint );
+						if ( standing == NAI::AIP_YES )
+							standingFloorMask |= ( 1 << floor );
+						if ( standing == NAI::AIP_YES && adjacent == NAI::AIP_YES )
+						{
+							edge = (int)NAI::GetTransitionType( network, standPoint, nextPoint );
+							if ( edge == NAI::TT_MOVE ) edgeFloorMask |= ( 1 << floor );
+						}
+					}
+				}
+			}
+			XPZ3DMoveTestLog( "event=deckscan_layer index=%d floor=%d pass=%d destination=%d z=%.3f stand=%d adjacent_stand=%d lateral_transition=%d",
+				layer, floor, (int)pass, dest ? 1 : 0, (double)surfaceHeight, standing, adjacent, edge );
+		}
+		XPZ3DMoveTestLog( "event=deckscan_end layers=%d valid_layers=%d floor_mask=%d complete_ten_decks=%d stand_mask=%d adjacent_edge_mask=%d routes_verified=0",
+			layerCount, validLayerCount, reachableFloorMask, reachableFloorMask == 1023 ? 1 : 0,
+			standingFloorMask, edgeFloorMask );
+		return;
+	}
 	// Candidates are nearby destinations in the existing native grid.
 	// Try a bounded set and use the unit's real CanDo(CCmdPath) preflight.
 	const int dx[] = {3,0,-3,0,2,-2,2,-2,4,0,-4,0,1,-1,0,0, 3,3,-3,-3};
