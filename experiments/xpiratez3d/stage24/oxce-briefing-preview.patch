+// Optional 3D preview is a sidecar, not an authoritative campaign handoff yet.
+// The existing 2D battle and save management remain completely untouched.
+void BriefingState::btn3dPreviewClick(Action *)
+{
+#ifdef _WIN32
+	if (_infoOnly || !_game->getSavedGame() || !_game->getSavedGame()->getSavedBattle())
+		return;
+	if (_game->getSavedGame()->getSavedBattle()->isPreview())
+	{
+		_txtBriefing->setText("The 3D preview does not support preview-only missions.");
+		return;
+	}
+	const char *script = std::getenv("XPZ3D_BRIDGE_LAUNCHER");
+	if (!script || !*script)
+		return;
+	// Store a complete versioned OXCE save in a uniquely named, disposable file.
+	// The bridge reads this, archives it outside the game tree and never writes
+	// 3D combat state back to the user's actual campaign. No native OXCE RNG
+	// consumers or combat setters are invoked here.
+	const std::string name = "_xpz3d_bridge_" + std::to_string(GetCurrentProcessId()) +
+		"_" + std::to_string(GetTickCount()) + ".sav";
+	try
+	{
+		_game->getSavedGame()->save(name, _game->getMod());
+		const std::string snapshot = Options::getMasterUserFolder() + name;
+		const intptr_t pid = _spawnlp(_P_NOWAIT, "powershell.exe", "powershell.exe",
+			"-NoProfile", "-ExecutionPolicy", "Bypass", "-File", script,
+			"-Save", snapshot.c_str(), "-LeaveOpen", (char*)0);
+		if (pid == -1)
+			_txtBriefing->setText("3D launcher failed. The original 2D mission is still available.");
+		else
+			_txtBriefing->setText("3D preview launched. Return here to play the original 2D battle.");
+	}
+	catch (...)
+	{
+		_txtBriefing->setText("Could not export the 3D snapshot; 2D mode is unchanged.");
+	}
+#endif
+}
