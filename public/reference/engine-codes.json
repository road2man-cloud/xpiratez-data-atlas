  "limits": [
    "TrainingMode changes award categories, not whether the hit qualifies for XP.",
    "XPZ adds stun/mind-control anti-farming scripts (Yankes_Scripts.rul).",
    "PSI modes require current psiSkill > 0 for a geoscape soldier.",
    "Explicit damageType is a base category, not final effective damage; damageAlter/ResistType/armor modifiers may override."
  ],
  "caveats": [
    "DamageType 10–19 are generic engine slots, not guaranteed semantic damage names across X-Piratez versions.",
    "RandomType fire mode returns an absolute configured FIRE_DAMAGE_RANGE rather than multiplying power.",
    "ExperienceTrainingMode selects award fields only; eligible unit/action rules, additional X-Piratez scripts and stat caps still apply.",
    "Direct item declarations in linked versioned JSON files do not include inherited or merged effective values."
  ]
